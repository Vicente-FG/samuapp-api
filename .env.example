# Plantilla de configuracion del backend de SAMUAPP.
# Copie a `.env` y complete los valores. NUNCA suba el archivo `.env`.

# Directorio con los artefactos publicados del modelo.
SAMUAPP_MODELOS_DIR=./modelos/

# Ruta del archivo SQLite con el historico de predicciones.
SAMUAPP_DB_PATH=./data/predicciones.db

# Mecanismo de verificacion de tokens: "firebase" (produccion) o "dev" (pruebas).
SAMUAPP_AUTH_MODE=firebase

# Duracion del token emitido por el modo "dev", en minutos.
SAMUAPP_SESION_TTL_MINUTOS=480

# Habilita la respuesta heuristica cuando no hay artefactos disponibles.
SAMUAPP_MODO_DEGRADADO=false

# Timeout maximo de la inferencia, en milisegundos.
SAMUAPP_TIMEOUT_MS=2000

# Version de codigo del servicio, persistida con cada prediccion.
SAMUAPP_VERSION_CODIGO=0.1.0

# Nivel de los logs JSON: DEBUG, INFO, WARNING, ERROR.
SAMUAPP_LOG_LEVEL=INFO

# Origenes CORS permitidos, separados por coma. Vacio: solo mismo origen.
SAMUAPP_CORS_ORIGENES=

# Project ID de Firebase (opcional: usa las credenciales por defecto).
SAMUAPP_FIREBASE_PROJECT_ID=

# Verifica la revocacion del token de Firebase en cada peticion.
SAMUAPP_FIREBASE_CHECK_REVOCADO=true

# Numero de inferencias concurrentes admitidas antes de responder 429.
SAMUAPP_MAX_CONCURRENCIA=32

# Exige un token valido para consultar el endpoint de salud.
SAMUAPP_HEALTH_REQUIERE_TOKEN=false
